[Unit]
Description=Data Analysis Service
After=network.target

[Service]
Type=simple
User=data-analysis
Group=data-analysis
WorkingDirectory=/opt/data-analysis
EnvironmentFile=/etc/data-analysis/secrets
ExecStart=/opt/data-analysis/.venv/bin/gunicorn \
    --bind ${ANALYSIS__HOST}:${ANALYSIS__PORT} \
    --workers 2 \
    --timeout 60 \
    "app:create_app()"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=data-analysis

[Install]
WantedBy=multi-user.target
